{
  "name": "cinesearch",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start:android",
    "ios": "expo start:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:snapshot": "jest tests/snapshot --updateSnapshot",
    "test:e2e:ios": "detox test --configuration ios.sim.debug",
    "test:e2e:ios:release": "detox test --configuration ios.sim.release",
    "test:e2e:android": "detox test --configuration android.emu.debug",
    "test:e2e:android:release": "detox test --configuration android.emu.release",
    "detox:build:ios": "detox build --configuration ios.sim.debug",
    "detox:build:ios:release": "detox build --configuration ios.sim.release",
    "detox:build:android": "detox build --configuration android.emu.debug",
    "detox:build:android:release": "detox build --configuration android.emu.release",
    "maestro:install": "brew install maestro",
    "maestro:version": "maestro --version",
    "maestro:doctor": "maestro doctor",
    "test:maestro": "maestro test maestro/flows/",
    "test:maestro:ios": "maestro test maestro/flows/ --platform ios",
    "test:maestro:android": "maestro test maestro/flows/ --platform android",
    "test:maestro:smoke": "maestro test maestro/flows/auth/login.yaml && maestro test maestro/flows/movies/discover.yaml",
    "test:maestro:auth": "maestro test maestro/flows/auth/login.yaml",
    "test:maestro:register": "maestro test maestro/flows/auth/register.yaml",
    "test:maestro:movies": "maestro test maestro/flows/movies/",
    "test:maestro:favorites": "maestro test maestro/flows/favorites/",
    "test:maestro:watchlist": "maestro test maestro/flows/watchlist/",
    "test:maestro:tabs": "maestro test maestro/flows/tabs/",
    "test:maestro:setup": "maestro test maestro/flows/setup/",
    "maestro:studio": "maestro studio",
    "maestro:record": "maestro record",
    "maestro:report": "maestro open-report",
    "maestro:check-id": "node maestro/scripts/check-app-id.js"
  },
